# Copy ke .env (JANGAN commit .env asli)
DATABASE_URL=postgresql://gobareng:gobareng@localhost:5432/gobareng
REDIS_URL=redis://localhost:6379
JWT_SECRET=ganti-dengan-secret-acak-min-32-karakter

# WhatsApp — OFFICIAL Business Cloud API ONLY (Meta).
# No unofficial gateway. Unset = WA sends skipped (fail-soft).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_SOS=sos_alert

# AI-V — SOS suara: provider STT OpenAI-compatible (/audio/transcriptions).
# Kosong = endpoint transkripsi balas 503 STT_NOT_CONFIGURED (fail-soft);
# tidak ada transkripsi palsu. Klasifikasi alasan AI (opsional) memakai
# META_MODEL_* di bawah; tanpa itu, klasifikasi keyword lokal yang jalan.
STT_PROVIDER=
STT_API_KEY=
STT_API_BASE=
STT_MODEL=whisper-1

# Meta Model API (Muse Spark Open via sponsor, OpenAI-compatible
# chat-completions base URL, mis. https://.../v1). Unset = fitur AI
# balas 503 AI_NOT_CONFIGURED (fail-soft, pipeline safety tetap jalan).
META_MODEL_API_KEY=
META_MODEL_API_BASE=
META_MODEL_NAME=muse-spark-open

PORT=3000
NODE_ENV=development

# CORS (comma-separated origins allowed to call the API)
CORS_ORIGIN=http://localhost:8081
